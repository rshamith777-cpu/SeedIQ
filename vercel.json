{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd seediq-frontend && npm install && npm run build",
  "outputDirectory": "seediq-frontend/.output/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
