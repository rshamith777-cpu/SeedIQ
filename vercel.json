{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd seediq-frontend && npm install && npm run build",
  "outputDirectory": "seediq-frontend/.output/public",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
