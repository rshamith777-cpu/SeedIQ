{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd seediq-frontend && npm install && npm run build",
  "outputDirectory": "seediq-frontend/.vercel/output/static",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://seediq-api.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
